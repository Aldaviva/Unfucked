<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
        <Version>0.0.1-beta.39</Version>
        <Description>Fix egregiously broken or missing functionality in System.Net.Http.HttpClient.</Description>
        <PackageTags>http HttpClient web request $(PackageTags)</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" PrivateAssets="all" /> <!-- Used if available, or ignored otherwise -->
    </ItemGroup>

    <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
        <PackageReference Include="System.Net.Http.Json" PrivateAssets="all" /> <!-- Used if available, or reimplemented otherwise -->
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>

    <Choose>
        <When Condition="'$(Configuration)' != 'Debug'">
            <ItemGroup>
                <PackageReference Include="Unfucked" />
                <PackageReference Include="Unfucked.Caching" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <ProjectReference Include="..\Caching\Caching.csproj" />
                <ProjectReference Include="..\Unfucked\Unfucked.csproj" />
            </ItemGroup>
        </Otherwise>
    </Choose>

</Project>