<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <UsingTask TaskName="Unfucked.BuildInfoGenerator.GenerateBuildInfo" AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Unfucked.BuildInfoGenerator.dll" Condition="'$(_IsExecutable)' == 'true'" />
    
    <PropertyGroup Condition="'$(_IsExecutable)' == 'true'">
        <_BuildInfoFilePath>$(IntermediateOutputPath)Unfucked.BuildInfo.g.cs</_BuildInfoFilePath>
    </PropertyGroup>
    
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(_IsExecutable)' == 'true'">
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <GenerateBuildInfo ProjectDir="$(MSBuildProjectDirectory)" OutputFile="$(_BuildInfoFilePath)" />

        <ItemGroup>
            <Compile Include="$(_BuildInfoFilePath)" />
        </ItemGroup>
    </Target>

    <Target Name="CleanBuildInfo" AfterTargets="AfterClean" Condition="'$(_IsExecutable)' == 'true'">
        <Delete Files="$(_BuildInfoFilePath)" />
    </Target>
    
    <ItemGroup>
        <Using Include="Unfucked" />
    </ItemGroup>

</Project>