<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    
    <PropertyGroup>
        <_BuildInfoFilePath>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'Unfucked.BuildInfo.g.cs'))</_BuildInfoFilePath>
    </PropertyGroup>

    <UsingTask TaskName="Unfucked.BuildInfoGenerator.GenerateBuildInfo" AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\Unfucked.BuildInfoGenerator.dll" Condition="'$(HasRuntimeOutput)' != 'true'" />
    
    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(HasRuntimeOutput)' != 'true'">
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <GenerateBuildInfo ProjectDir="$(MSBuildProjectDirectory)" OutputFile="$(_BuildInfoFilePath)" />
        <!-- <Message Text="Generated build info $(_BuildInfoFilePath)" Importance="high" /> -->

        <ItemGroup>
            <Compile Include="$(_BuildInfoFilePath)" />
        </ItemGroup>
    </Target>

    <Target Name="CleanBuildInfo" AfterTargets="AfterClean" Condition="'$(HasRuntimeOutput)' != 'true'">
        <Delete Files="$(_BuildInfoFilePath)" />
    </Target>
    
    <ItemGroup>
        <Using Include="Unfucked" />
    </ItemGroup>

</Project>